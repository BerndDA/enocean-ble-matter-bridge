diff --git a/Makefile b/Makefile
index 5866d15..d0dd477 100644
--- a/Makefile
+++ b/Makefile
@@ -420,13 +420,23 @@ CFLAGS += -DDFU_APP_DATA_RESERVED=$(DFU_APP_DATA_RESERVED)
 
 LDFLAGS += \
 	$(CFLAGS) \
-	-Wl,-L,linker -Wl,-T,$(LD_FILE) \
+	-Wl,-L,linker -T$(LD_FILE) \
 	-Wl,--print-memory-usage \
 	-Wl,-Map=$@.map -Wl,-cref -Wl,-gc-sections \
-	-specs=nosys.specs -specs=nano.specs
+	$(LIBC_SPECS)
 
 LIBS += -lm -lc
 
+# Zephyr SDK GCC (arm-zephyr-eabi, from the nRF Connect SDK) has picolibc instead of newlib-nano:
+# no nosys/nano specs and no crt0, so the nrfx startup clears .bss and calls main itself.
+# The linker script goes to the driver as -T, otherwise the driver adds picolibc.ld.
+ifeq ($(CROSS_COMPILE),arm-zephyr-eabi-)
+LIBC_SPECS = -nostartfiles
+CFLAGS += -D__START=main -D__STARTUP_CLEAR_BSS
+else
+LIBC_SPECS = -specs=nosys.specs -specs=nano.specs
+endif
+
 #------------------------------------------------------------------------------
 # Assembler flags
 #------------------------------------------------------------------------------
