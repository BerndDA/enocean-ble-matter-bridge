diff --git a/Makefile b/Makefile
index 5866d15..af14b0a 100644
--- a/Makefile
+++ b/Makefile
@@ -420,13 +420,23 @@ CFLAGS += -DDFU_APP_DATA_RESERVED=$(DFU_APP_DATA_RESERVED)
 
 LDFLAGS += \
 	$(CFLAGS) \
-	-Wl,-L,linker -Wl,-T,$(LD_FILE) \
+	-Wl,-L,linker -T$(LD_FILE) \
 	-Wl,--print-memory-usage \
 	-Wl,-Map=$@.map -Wl,-cref -Wl,-gc-sections \
-	-specs=nosys.specs -specs=nano.specs
+	$(LIBC_SPECS)
 
 LIBS += -lm -lc
 
+# Zephyr SDK GCC (arm-zephyr-eabi, from the nRF Connect SDK) has picolibc instead of newlib-nano:
+# no nosys/nano specs and no crt0, so the nrfx startup clears .bss and calls main itself.
+# The linker script goes to the driver as -T, otherwise the driver adds picolibc.ld.
+ifeq ($(CROSS_COMPILE),arm-zephyr-eabi-)
+LIBC_SPECS = -nostartfiles
+CFLAGS += -D__START=main -D__STARTUP_CLEAR_BSS
+else
+LIBC_SPECS = -specs=nosys.specs -specs=nano.specs
+endif
+
 #------------------------------------------------------------------------------
 # Assembler flags
 #------------------------------------------------------------------------------
@@ -436,6 +446,13 @@ ASFLAGS += $(CFLAGS)
 #function for removing duplicates in a list
 remduplicates = $(strip $(if $1,$(firstword $1) $(call remduplicates,$(filter-out $(firstword $1),$1))))
 
+# NO_BLE_OTA = 1 (board.mk): no BLE OTA DFU, for boards that never have a SoftDevice for it
+ifeq ($(NO_BLE_OTA), 1)
+CFLAGS += -DNO_BLE_OTA
+C_SRC := $(filter-out $(SDK11_PATH)/libraries/bootloader_dfu/dfu_transport_ble.c \
+  $(SDK11_PATH)/ble/ble_services/ble_dfu/ble_dfu.c $(SDK11_PATH)/ble/ble_services/ble_dis/ble_dis.c,$(C_SRC))
+endif
+
 C_SOURCE_FILE_NAMES = $(notdir $(C_SRC))
 C_PATHS = $(call remduplicates, $(dir $(C_SRC) ) )
 C_OBJECTS = $(addprefix $(BUILD)/, $(C_SOURCE_FILE_NAMES:.c=.o) )
