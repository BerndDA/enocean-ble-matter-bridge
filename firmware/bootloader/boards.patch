+// non-empty chunks of the config block, then the UICR block. Copied onto another board's drive,
+// it installs this bootloader. The rest of the bootloader region is left out on purpose: a
+// bootloader update copies its whole 40 KB staging area (BOOTLOADER_ADDR_NEW_RECEIVED) into the
+// region, so old app or factory data can sit there, and it must not be staged onto another board.
+// bootfile_scan() counts the blocks at uf2_init().
+#define BOOTFILE_CFG_START    (BOOTLOADER_ADDR_END - 0x800) // BOOTLOADER_CONFIG in the linker script
+#define BOOTFILE_CFG_CHUNKS   (0x800 / UF2_FIRMWARE_BYTES_PER_SECTOR)
+#define BOOTFILE_FIRST_SECTOR (PREV_LAST_SECTOR + 1)
+
+static uint32_t bootfile_code_chunks;
+static uint8_t  bootfile_cfg[BOOTFILE_CFG_CHUNKS];
+static uint32_t bootfile_cfg_count;
+
+static bool chunk_is_empty(uint32_t addr)
+{
+  uint32_t const *p = (uint32_t const *) addr;
+  for (uint32_t i = 0; i < UF2_FIRMWARE_BYTES_PER_SECTOR / 4; i++) {
+    if (p[i] != 0xFFFFFFFF) return false;
+  }
+  return true;
+}
+
+extern uint32_t __etext, __data_start__, __data_end__; // nrf_common.ld
+
+static void bootfile_scan(void)
+{
+  uint32_t const image_end = (uint32_t) &__etext + ((uint32_t) &__data_end__ - (uint32_t) &__data_start__);
+  bootfile_code_chunks = (image_end - BOOTLOADER_ADDR_START + UF2_FIRMWARE_BYTES_PER_SECTOR - 1) / UF2_FIRMWARE_BYTES_PER_SECTOR;
+  bootfile_cfg_count = 0;
+  for (uint32_t i = 0; i < BOOTFILE_CFG_CHUNKS; i++) {
+    if (!chunk_is_empty(BOOTFILE_CFG_START + i * UF2_FIRMWARE_BYTES_PER_SECTOR)) bootfile_cfg[bootfile_cfg_count++] = (uint8_t) i;
+  }
+}
+
+static inline uint32_t bootfile_blocks(void)
+{
+  return bootfile_code_chunks + bootfile_cfg_count + 1; // + UICR
+}
+
+static uint32_t bootfile_addr(uint32_t block)
+{
+  if (block < bootfile_code_chunks) return BOOTLOADER_ADDR_START + block * UF2_FIRMWARE_BYTES_PER_SECTOR;
+  block -= bootfile_code_chunks;
+  if (block < bootfile_cfg_count) return BOOTFILE_CFG_START + bootfile_cfg[block] * UF2_FIRMWARE_BYTES_PER_SECTOR;
+  return 0x10001000; // UICR: bootloader and MBR params addresses, checked by write_block()
+}
