+static inline bool is_settings_block (UF2_Block const *bl)
+{
+  if (bl->targetAddr < BOARD_SETTINGS_ADDR || bl->targetAddr >= BOARD_SETTINGS_ADDR + BOARD_SETTINGS_SIZE) return false;
+  uint32_t const pos = (bl->targetAddr - BOARD_SETTINGS_ADDR) / UF2_FIRMWARE_BYTES_PER_SECTOR;
