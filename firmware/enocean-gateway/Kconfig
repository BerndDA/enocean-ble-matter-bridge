mainmenu "EnOcean-to-Matter-over-Thread Gateway"

# The TCM on a UART, interrupt-driven receive into a ring buffer
config SERIAL
	default y

config UART_INTERRUPT_DRIVEN
	default y

config RING_BUFFER
	default y

menu "EnOcean gateway"

config GATEWAY_ENOCEAN_MAX_DEVICES
	int "Maximum number of bridged EnOcean endpoints"
	default 16
	help
	  Each endpoint (an actuator, or one lamp of a two-channel actuator) uses one bridge provider
	  and one dynamic endpoint. See
	  BRIDGE_MAX_BRIDGED_DEVICES_NUMBER and BRIDGE_MAX_DYNAMIC_ENDPOINTS_NUMBER.

config GATEWAY_ENOCEAN_SEEN_MAX
	int "Number of senders kept in the 'heard' table"
	default 16

config GATEWAY_ENOCEAN_QUEUE_SIZE
	int "Telegrams queued between the TCM and Matter threads"
	default 8

config GATEWAY_ENOCEAN_RX_STACK_SIZE
	int "Stack size of the TCM receive thread"
	default 1024

config GATEWAY_LAMETRIC
	bool "LaMetric Time follows the power of an actuator"
	depends on OPENTHREAD_SOURCES && SETTINGS
	select OPENTHREAD_TCP_ENABLE
	help
	  When a D2-01 actuator (the kitchen radio) draws power, the LaMetric
	  Time's screensaver is turned off and its radio app plays; at 0 W the
	  screensaver is turned on and the radio stops. Local REST API over plain HTTP on OpenThread's
	  TCP; an IPv4 clock is reached through the border router's NAT64.
	  Set up in the shell: `lametric host|key|trigger`. See
	  src/lametric/lametric.h.

if GATEWAY_LAMETRIC

config GATEWAY_LAMETRIC_PORT
	int "Default HTTP port of the clock's local API"
	default 8080

config GATEWAY_LAMETRIC_ON_W
	int "Power (W) from which the clock is switched on"
	default 1
	range 1 10000

endif # GATEWAY_LAMETRIC

module = GATEWAY_ENOCEAN
module-str = Gateway EnOcean
source "subsys/logging/Kconfig.template.log_config"

endmenu

rsource "../common/Kconfig"
