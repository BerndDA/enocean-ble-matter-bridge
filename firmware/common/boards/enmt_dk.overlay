/*
 * nRF52840 DK standing in for the EnMT carrier: the carrier's UF2 build (promicro_nrf52840/nrf52840/uf2,
 * the same as BOARD=enmt) with its status LEDs and function button on the DK's own LEDs and Button 1.
 * For a DK with the EnMT bootloader for the DK (firmware/bootloader, board enmt_dk), flashed over
 * the DK's nRF USB port (J3). `make BOARD=enmt-dk`.
 *
 * The DK's LEDs are active low, like the carrier's:
 *   LED1  P0.13  green LINK  Matter/Thread status (Nrf::Board)
 *   LED2  P0.14  yellow RX   short pulse per packet from a bridged device; Matter Identify blinks it
 *   LED3  P0.15  red PWR     on; blinks while the app's health check fails
 *   LED4  P0.16  stands in for the nice!nano's own LED
 * Button 1 (P0.11) is the function button: held for 6 s, factory reset. P0.11 is i2c0's SCL in the
 * Pro Micro board files; i2c0 is disabled in the apps' promicro_nrf52840_common.dtsi.
 * See enmt_carrier.overlay and common/status_leds/.
 */

/* led0 keeps its label: the board's aliases (led0, mcuboot-led0) point at it. */
&led0 {
	gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
	label = "LINK LED (green, LED1)";
};

&button0 {
	gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	label = "Function button (Button 1)";
};

/ {
	leds {
		led_rx: led_1 {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			label = "RX LED (yellow, LED2)";
		};

		led_pwr: led_2 {
			gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
			label = "PWR LED (red, LED3)";
		};

		led_module: led_3 {
			gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
			label = "LED4";
		};
	};

	aliases {
		led1 = &led_rx;
		led2 = &led_pwr;
		led3 = &led_module;
	};
};

/*
 * QSPI flash (MX25R6435F, 8 MB, as in Zephyr's nrf52840dk board files) for Matter OTA: the app
 * stages an update there, the EnMT bootloader installs it (common/ota/gateway_ota.h,
 * firmware/bootloader/enmt_ota.h). The offsets are fixed by the bootloader.
 */
&pinctrl {
	qspi_default: qspi_default {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK, 0, 19)>,
				<NRF_PSEL(QSPI_IO0, 0, 20)>,
				<NRF_PSEL(QSPI_IO1, 0, 21)>,
				<NRF_PSEL(QSPI_IO2, 0, 22)>,
				<NRF_PSEL(QSPI_IO3, 0, 23)>,
				<NRF_PSEL(QSPI_CSN, 0, 17)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	qspi_sleep: qspi_sleep {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK, 0, 19)>,
				<NRF_PSEL(QSPI_IO0, 0, 20)>,
				<NRF_PSEL(QSPI_IO1, 0, 21)>,
				<NRF_PSEL(QSPI_IO2, 0, 22)>,
				<NRF_PSEL(QSPI_IO3, 0, 23)>;
			low-power-enable;
		};

		group2 {
			psels = <NRF_PSEL(QSPI_CSN, 0, 17)>;
			low-power-enable;
			bias-pull-up;
		};
	};
};

&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	ext_flash: mx25r6435f@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		writeoc = "pp4io";
		readoc = "read4io";
		sck-frequency = <8000000>;
		jedec-id = [c2 28 17];
		sfdp-bfp = [e5 20 f1 ff ff ff ff 03 44 eb 08 6b 08 3b 04 bb
			    ee ff ff ff ff ff 00 ff ff ff 00 ff 0c 20 0f 52
			    10 d8 00 ff 23 72 f5 00 82 ed 04 cc 44 83 68 44
			    30 b0 30 b0 f7 c4 d5 5c 00 be 29 ff f0 d0 ff ff];
		size = <67108864>;
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			ota_header_partition: partition@0 {
				label = "ota-header";
				reg = <0x00000000 DT_SIZE_K(4)>;
			};

			ota_slot_partition: partition@1000 {
				label = "ota-slot";
				reg = <0x00001000 DT_SIZE_K(888)>;
			};
		};
	};
};
